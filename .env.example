# Copy to .env for local development. Never commit .env.

# Database (Neon: pooled connection string for runtime; migrations run in the build step)
DATABASE_URL=postgresql://payload:payload@localhost:5432/atmjet_dev

# Payload. The secret signs every session, so it is refused if it is still the line below:
# generate one with `openssl rand -hex 32` (docs/environment.md).
PAYLOAD_SECRET=change-me-to-a-long-random-string
PREVIEW_SECRET=

# Site. On Vercel the production domain is the default (#403); set this only to override it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GTM_ID=

# Media storage (S3-compatible, bucket "atmjet" in eu-north-1; configured in E1)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Integrations (E9). TELEGRAM_CHAT_IDS is a comma-separated list; without both variables a lead
# is still stored, and its delivery is recorded as failed rather than throwing (issue #161).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# The queue that sends leads (E9.5). Vercel signs its cron calls to /api/payload-jobs/run with
# this; leave it empty locally and drain the queue from the admin instead.
CRON_SECRET=

# Testing
PLAYWRIGHT_BASE_URL=
VERCEL_AUTOMATION_BYPASS_SECRET=

# Seed (bun run seed): the local admin account; never seeded with NODE_ENV=production
SEED_ADMIN_EMAIL=dev@atmjet.local
SEED_ADMIN_PASSWORD=dev-password-change-me
