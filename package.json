{
  "name": "atmjet-website",
  "version": "0.1.0",
  "private": true,
  "description": "ATM JET website: Payload 3 + Next.js 16 (Bun)",
  "license": "UNLICENSED",
  "packageManager": "bun@1.3.11",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "ci": "bun run scripts/db/deploy-migrations.ts && bun run build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "knip": "knip --production && knip",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "prepare": "lefthook install",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "bun run test:int && bun run test:e2e && bun run test:visual && bun run test:a11y",
    "test:a11y": "cross-env NODE_OPTIONS=--no-deprecation playwright test --project=a11y",
    "test:e2e": "cross-env NODE_OPTIONS=--no-deprecation playwright test --project=e2e",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts --coverage",
    "test:lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "test:visual": "cross-env NODE_OPTIONS=--no-deprecation playwright test --project=visual",
    "test:visual:update": "bash scripts/ci/visual-update.sh",
    "typecheck": "next typegen && tsc --noEmit",
    "baselines:legacy": "bun run scripts/baselines/capture-legacy.ts",
    "visual:bundle": "bash scripts/baselines/download-legacy-bundle.sh",
    "seed": "bun run scripts/seed/index.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/plugin-redirects": "3.89.0",
    "@payloadcms/plugin-seo": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/translations": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.20",
    "cross-env": "^10.1.0",
    "embla-carousel-react": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "graphql": "^17.0.2",
    "libphonenumber-js": "^1.13.13",
    "motion": "^13.2.0",
    "next": "16.3.5",
    "next-intl": "^4.14.4",
    "payload": "3.89.0",
    "postcss": "^8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/pngjs": "6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.5.2",
    "@vitest/coverage-v8": "4.0.18",
    "axe-core": "4.13.0",
    "dotenv": "17.4.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "jsdom": "30.0.1",
    "knip": "^6.35.1",
    "lefthook": "^2.1.12",
    "pixelmatch": "7",
    "pngjs": "7",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "schema-dts": "^2.0.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "24.x"
  },
  "trustedDependencies": [
    "sharp",
    "esbuild",
    "unrs-resolver"
  ]
}
